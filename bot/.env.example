# Copy to bot/.env for local dev. For Fly.io, set these with `fly secrets set` (see docs/bot.md).
# Data-source credentials (GARMIN_*, STRAVA_*, DATA_SOURCES) live in the workspace-root .env
# locally; on Fly.io set them as secrets too so the 06:00 sync can run.

# --- Telegram bot ---
# Get from @BotFather: /newbot, then save the token it gives you.
TELEGRAM_BOT_TOKEN=

# Your Telegram user ID (numeric). The bot will ONLY respond to this user.
# To find it: message the bot once — it replies with your ID — or ask @userinfobot.
TELEGRAM_ALLOWED_USER_ID=

# --- LLMs ---
# Gemini Flash for chat Q&A (free tier). https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Claude for the Sunday weekly review. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5; set claude-sonnet-5-5 to cut cost.
# ANTHROPIC_MODEL=claude-opus-5-5

# --- Workspace repo (cloud deploy only) ---
# On Fly.io the bot clones your PRIVATE copy of this repo and pushes notes back to it.
# Leave empty for local dev — the bot then uses the parent directory of bot/.
WORKSPACE_REPO_URL=
WORKSPACE_REPO_BRANCH=main
# Fine-grained GitHub PAT: only your workspace repo, Contents = Read and write.
# https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=

# Timezone for the daily pings and the Sunday review
TIMEZONE=Europe/London
