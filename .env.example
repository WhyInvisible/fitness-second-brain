# Copy to .env (gitignored) and fill in what you use. /setup walks through this.
# Telegram bot settings live separately in bot/.env (see bot/.env.example).

# --- Where your training data comes from ---------------------------------
# Comma-separated, highest priority first. When two sources record the same
# session, the first one listed wins. Options: garmin, apple_health, strava, files
# Leave empty to log everything by hand. See docs/data-sources.md.
DATA_SOURCES=

# Garmin Connect (your normal garmin.com login; tokens cached in ~/.garminconnect)
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Apple Health / Apple Watch: folder the iPhone exports into (export.zip or
# Health Auto Export JSON). Defaults to data/inbox/apple-health/
APPLE_HEALTH_DIR=

# Strava (covers Coros, Polar, Suunto, Wahoo, Zwift...): create an app at
# https://www.strava.com/settings/api, then run: python scripts/sync.py --source strava --auth
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# FIT / GPX / TCX file drop. Defaults to data/inbox/files/
ACTIVITY_FILES_DIR=

# --- Published pages (Claude Artifacts) ----------------------------------
# true: Claude Code hooks rebuild the pages when data changes and make the agent
# publish them before it finishes its turn. false: only report at session start.
AUTO_PUBLISH_ARTIFACTS=true

# --- Weather (optional, dashboard + scripts/weather-lookup.py) ----------
# Free key: https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=
DEFAULT_LAT=
DEFAULT_LON=
DEFAULT_LOCATION_NAME=
